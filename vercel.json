{
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/cocoa?endpoint=/api/auth/:path*"
    },
    {
      "source": "/api/cocoa/session",
      "destination": "/api/cocoa?endpoint=/api/cocoa/session"
    },
    {
      "source": "/api/cocoa/workspace",
      "destination": "/api/cocoa?endpoint=/api/cocoa/workspace"
    }
  ],
  "headers": [
    {
      "source": "/companion/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/kiro",
      "destination": "/kiro/",
      "permanent": true
    },
    {
      "source": "/photography",
      "destination": "/photography/",
      "permanent": true
    }
  ]
}
